# Copy to `.env` (git-ignored) at the repo root. Read by:
#   - the Rust backend at startup (dotenvy; real env vars win) and systemd
#     (`EnvironmentFile=` in deploy/hookbox.service)
#   - Vite at build time (only `VITE_*` keys reach the browser bundle)
#   - docker compose (auto-loads `.env` next to docker-compose.yml)

# Cloudflare Turnstile — guards the first anonymous session mint
# (POST /api/session). Leave the secret empty to disable verification
# (local dev / tests); the backend logs a warning at boot when disabled.
TURNSTILE_SECRET_KEY=
# Public site key, baked into the SPA bundle. Empty = no widget rendered.
VITE_TURNSTILE_SITE_KEY=
# Optional comma-separated hostnames a token may be issued for.
# Defaults to APP_HOST. Never include localhost in production.
# TURNSTILE_HOSTNAMES=hookbox.lgtm.my.id
