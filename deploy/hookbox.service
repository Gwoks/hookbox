[Unit]
Description=HookBox API Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory={{APP_DIR}}/backend
ExecStart={{APP_DIR}}/backend/target/release/hookbox
Environment="DATABASE_PATH={{APP_DIR}}/data/app.db"
Environment="STATIC_DIR={{APP_DIR}}/dist"
Environment="APP_HOST=0.0.0.0"
Environment="APP_PORT={{APP_PORT}}"
Environment="MOCK_DOMAIN={{MOCK_DOMAIN}}"
Environment="PUBLIC_BASE_URL={{PUBLIC_BASE_URL}}"
Restart=unless-stopped
RestartSec=5

[Install]
WantedBy=multi-user.target
